FROM ventas v
JOIN clientes c
ON v.id_cliente = c.id_cliente;

-- =========================================
-- 15 CONSULTAS VENDEDOR
-- =========================================

-- 1. Productos vendidos hoy
SELECT
    p.descripcion_producto,
    SUM(dv.cantidad) AS total
FROM detalle_venta dv
JOIN productos p
ON dv.id_producto = p.id_producto
JOIN ventas v
ON dv.id_venta = v.id_venta
WHERE v.fecha = CURRENT_DATE
GROUP BY p.descripcion_producto;

-- 2. Ventas realizadas por fecha
SELECT *
FROM ventas
ORDER BY fecha DESC;

-- 3. Clientes atendidos por empleado
SELECT
    e.nombre,
    COUNT(v.id_cliente) AS clientes
FROM empleados e
JOIN ventas v
ON e.id_empleado = v.id_empleado
GROUP BY e.nombre;

-- 4. Productos vendidos por categoría
SELECT
    c.nombre AS categoria,
    SUM(dv.cantidad) AS vendidos
FROM categorias c
JOIN productos p
ON c.id_categoria = p.id_categoria
JOIN detalle_venta dv
ON p.id_producto = dv.id_producto
GROUP BY categoria;

-- 5. Ventas del último mes
SELECT *
FROM ventas
WHERE fecha >= CURRENT_DATE - INTERVAL '30 days';

-- 6. Clientes frecuentes
SELECT
    c.nombre,
    COUNT(v.id_venta) AS compras
FROM clientes c
JOIN ventas v
ON c.id_cliente = v.id_cliente
GROUP BY c.nombre
ORDER BY compras DESC;

-- 7. Productos más pedidos
SELECT
    p.descripcion_producto,
    COUNT(*) AS veces_vendido
FROM productos p
JOIN detalle_venta dv
ON p.id_producto = dv.id_producto
GROUP BY p.descripcion_producto
ORDER BY veces_vendido DESC;

-- 8. Productos nunca vendidos
SELECT
    descripcion_producto
FROM productos
WHERE id_producto NOT IN(
    SELECT id_producto
    FROM detalle_venta
);

-- 9. Ventas realizadas por empleado
SELECT
    e.nombre,
    COUNT(v.id_venta) AS total_ventas
FROM empleados e
JOIN ventas v
ON e.id_empleado = v.id_empleado
GROUP BY e.nombre;

-- 10. Promedio de ventas por día
SELECT
    fecha,
    AVG(dv.cantidad * dv.precio_unitario) AS promedio
FROM ventas v
JOIN detalle_venta dv
ON v.id_venta = dv.id_venta
GROUP BY fecha;

-- 11. Venta más alta registrada
SELECT
    v.id_venta,
    SUM(dv.cantidad * dv.precio_unitario) AS total
FROM ventas v
JOIN detalle_venta dv
ON v.id_venta = dv.id_venta
GROUP BY v.id_venta
ORDER BY total DESC
LIMIT 1;

-- 12. Venta más baja registrada
SELECT
    v.id_venta,
    SUM(dv.cantidad * dv.precio_unitario) AS total
FROM ventas v
JOIN detalle_venta dv
ON v.id_venta = dv.id_venta
GROUP BY v.id_venta
ORDER BY total ASC
LIMIT 1;

-- 13. Productos vendidos por empleado
SELECT
    e.nombre,
    p.descripcion_producto,
    SUM(dv.cantidad) AS vendidos
FROM empleados e
JOIN ventas v
ON e.id_empleado = v.id_empleado
JOIN detalle_venta dv
ON v.id_venta = dv.id_venta
JOIN productos p
ON dv.id_producto = p.id_producto
GROUP BY e.nombre, p.descripcion_producto;

-- 14. Clientes que compraron bebidas
SELECT DISTINCT
    c.nombre,
    c.apellido
FROM clientes c
JOIN ventas v
ON c.id_cliente = v.id_cliente
JOIN detalle_venta dv
ON v.id_venta = dv.id_venta
JOIN productos p
ON dv.id_producto = p.id_producto
WHERE p.id_categoria = 1;

-- 15. Cantidad vendida por producto
SELECT
    p.descripcion_producto,
    SUM(dv.cantidad) AS total
FROM productos p
JOIN detalle_venta dv
ON p.id_producto = dv.id_producto
GROUP BY p.descripcion_producto;



