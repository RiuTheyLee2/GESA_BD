-- =========================================================
--          MÓDULO 3 : CAJERO
-- =========================================================
-- =========================================================

-- =========================================
-- VISTA CAJERO
-- =========================================

CREATE OR REPLACE VIEW vista_cajero_pagos AS
SELECT
    p.id_pago,
    v.id_venta,
    mp.tipo AS metodo_pago,
    p.monto,
    v.fecha
FROM pagos p
JOIN ventas v
ON p.id_venta = v.id_venta
JOIN metodo_pago mp
ON p.id_metodo = mp.id_metodo;

-- =========================================
-- 15 CONSULTAS CAJERO
-- =========================================

-- 1. Total cobrado por día
SELECT
    v.fecha,
    SUM(p.monto) AS total_cobrado
FROM pagos p
JOIN ventas v
ON p.id_venta = v.id_venta
GROUP BY v.fecha;

-- 2. Método de pago más utilizado
SELECT
    mp.tipo,
    COUNT(*) AS veces_usado
FROM pagos p
JOIN metodo_pago mp
ON p.id_metodo = mp.id_metodo
GROUP BY mp.tipo
ORDER BY veces_usado DESC;

-- 3. Total cobrado por método de pago
SELECT
    mp.tipo,
    SUM(p.monto) AS total
FROM pagos p
JOIN metodo_pago mp
ON p.id_metodo = mp.id_metodo
GROUP BY mp.tipo;

-- 4. Ventas pagadas con efectivo
SELECT
    v.id_venta,
    p.monto
FROM pagos p
JOIN ventas v
ON p.id_venta = v.id_venta
WHERE p.id_metodo = 1;

-- 5. Ventas pagadas con tarjeta
SELECT
    v.id_venta,
    p.monto
FROM pagos p
JOIN ventas v
ON p.id_venta = v.id_venta
WHERE p.id_metodo IN (3,4);

-- 6. Promedio de pagos realizados
SELECT
    ROUND(AVG(monto),2) AS promedio_pago
FROM pagos;

-- 7. Pago más alto registrado
SELECT *
FROM pagos
ORDER BY monto DESC
LIMIT 1;

-- 8. Pago más bajo registrado
SELECT *
FROM pagos
ORDER BY monto ASC
LIMIT 1;

-- 9. Ventas sin pago registrado
SELECT
    v.id_venta,
    v.fecha
FROM ventas v
LEFT JOIN pagos p
ON v.id_venta = p.id_venta
WHERE p.id_pago IS NULL;

-- 10. Cantidad de pagos realizados
SELECT
    COUNT(*) AS total_pagos
FROM pagos;

-- 11. Recaudación total del sistema
SELECT
    SUM(monto) AS total_recaudado
FROM pagos;

-- 12. Recaudación mensual
SELECT
    TO_CHAR(v.fecha,'YYYY-MM') AS mes,
    SUM(p.monto) AS total
FROM pagos p
JOIN ventas v
ON p.id_venta = v.id_venta
GROUP BY mes
ORDER BY mes;

-- 13. Cantidad de ventas por método de pago
SELECT
    mp.tipo,
    COUNT(v.id_venta) AS ventas
FROM metodo_pago mp
JOIN pagos p
ON mp.id_metodo = p.id_metodo
JOIN ventas v
ON p.id_venta = v.id_venta
GROUP BY mp.tipo;

-- 14. Pagos realizados hoy
SELECT *
FROM pagos p
JOIN ventas v
ON p.id_venta = v.id_venta
WHERE v.fecha = CURRENT_DATE;

-- 15. Clientes que realizaron mayores pagos
SELECT
    c.nombre,
    c.apellido,
    SUM(p.monto) AS total_pagado
FROM clientes c
JOIN ventas v
ON c.id_cliente = v.id_cliente
JOIN pagos p
ON v.id_venta = p.id_venta
GROUP BY c.id_cliente
ORDER BY total_pagado DESC
LIMIT 10;



