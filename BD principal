-- =========================================
-- VISTA ALMACÉN
-- =========================================

CREATE OR REPLACE VIEW vista_almacen_stock AS
SELECT
    p.codigo_producto,
    p.descripcion_producto,
    c.nombre AS categoria,
    i.stock
FROM productos p
JOIN categorias c
ON p.id_categoria = c.id_categoria
JOIN inventario i
ON p.id_producto = i.id_producto;

-- =========================================
-- 15 CONSULTAS ALMACÉN
-- =========================================

-- 1. Productos con stock crítico
SELECT
    p.descripcion_producto,
    i.stock
FROM productos p
JOIN inventario i
ON p.id_producto = i.id_producto
WHERE i.stock < 10;

-- 2. Productos agotados
SELECT
    p.descripcion_producto
FROM productos p
JOIN inventario i
ON p.id_producto = i.id_producto
WHERE i.stock = 0;

-- 3. Productos con mayor stock
SELECT
    p.descripcion_producto,
    i.stock
FROM productos p
JOIN inventario i
ON p.id_producto = i.id_producto
ORDER BY i.stock DESC
LIMIT 10;

-- 4. Productos con menor stock
SELECT
    p.descripcion_producto,
    i.stock
FROM productos p
JOIN inventario i
ON p.id_producto = i.id_producto
ORDER BY i.stock ASC
LIMIT 10;

-- 5. Stock total del inventario
SELECT
    SUM(stock) AS stock_total
FROM inventario;

-- 6. Cantidad de productos registrados
SELECT
    COUNT(*) AS total_productos
FROM productos;

-- 7. Productos por categoría
SELECT
    c.nombre AS categoria,
    COUNT(p.id_producto) AS cantidad
FROM categorias c
JOIN productos p
ON c.id_categoria = p.id_categoria
GROUP BY c.nombre;

-- 8. Productos nunca vendidos
SELECT
    descripcion_producto
FROM productos
WHERE id_producto NOT IN (
    SELECT id_producto
    FROM detalle_venta
);

-- 9. Productos más vendidos
SELECT
    p.descripcion_producto,
    SUM(dv.cantidad) AS vendidos
FROM productos p
JOIN detalle_venta dv
ON p.id_producto = dv.id_producto
GROUP BY p.descripcion_producto
ORDER BY vendidos DESC
LIMIT 10;

-- 10. Productos menos vendidos
SELECT
    p.descripcion_producto,
    SUM(dv.cantidad) AS vendidos
FROM productos p
JOIN detalle_venta dv
ON p.id_producto = dv.id_producto
GROUP BY p.descripcion_producto
ORDER BY vendidos ASC
LIMIT 10;

-- 11. Valor total del inventario
SELECT
    SUM(i.stock * p.precio) AS valor_total
FROM inventario i
JOIN productos p
ON i.id_producto = p.id_producto;

-- 12. Productos con precio mayor a 20
SELECT
    descripcion_producto,
    precio
FROM productos
WHERE precio > 20;

-- 13. Productos ordenados por categoría
SELECT
    c.nombre AS categoria,
    p.descripcion_producto
FROM categorias c
JOIN productos p
ON c.id_categoria = p.id_categoria
ORDER BY categoria;

-- 14. Productos comprados a proveedores
SELECT
    p.descripcion_producto,
    pr.nombre AS proveedor
FROM productos p
JOIN detalle_compra dc
ON p.id_producto = dc.id_producto
JOIN compras c
ON dc.id_compra = c.id_compra
JOIN proveedores pr
ON c.id_proveedor = pr.id_proveedor;

-- 15. Promedio de stock por producto
SELECT
    ROUND(AVG(stock),2) AS promedio_stock
FROM inventario;

-- Stck y vendidos
--Productos que bajarán de stock pronto
SELECT
    p.descripcion_producto,
    i.stock,
    SUM(dv.cantidad) AS vendidos
FROM productos p
INNER JOIN inventario i
ON p.id_producto = i.id_producto
INNER JOIN detalle_venta dv
ON p.id_producto = dv.id_producto
GROUP BY p.descripcion_producto, i.stock
HAVING i.stock < SUM(dv.cantidad)
ORDER BY vendidos DESC;
