-- 1. Vista: Dashboard Financiero Mensual
-- Consolidado de ingresos, costos y volumen de transacciones por mes.
CREATE OR REPLACE VIEW vista_resumen_financiero AS
SELECT 
    TO_CHAR(v.fecha, 'YYYY-MM') AS periodo,
    SUM(dv.cantidad * dv.precio_unitario) AS ingresos_totales,
    COUNT(DISTINCT v.id_venta) AS total_pedidos
FROM ventas v
JOIN detalle_venta dv ON v.id_venta = dv.id_venta
GROUP BY periodo;
SELECT * FROM vista_resumen_financiero;

-- 2. Vista: Perfil 360 del Cliente
-- Muestra el historial acumulado, total gastado y frecuencia de cada cliente.
CREATE OR REPLACE VIEW vista_clientes_vip AS
SELECT 
    c.id_cliente,
    c.nombre || ' ' || c.apellido AS cliente,
    COUNT(v.id_venta) AS total_compras,
    SUM(dv.cantidad * dv.precio_unitario) AS total_gastado,
    MAX(v.fecha) AS ultima_visita
FROM clientes c
LEFT JOIN ventas v ON c.id_cliente = v.id_cliente
LEFT JOIN detalle_venta dv ON v.id_venta = dv.id_venta
GROUP BY c.id_cliente;
SELECT * FROM vista_clientes_vip;

-- 3. Vista: Alerta de Reabastecimiento
-- Identifica automáticamente los productos con stock crítico o agotados.
CREATE OR REPLACE VIEW vista_alerta_stock AS
SELECT 
    p.codigo_producto,
    p.descripcion_producto,
    i.stock,
    CASE 
        WHEN i.stock = 0 THEN 'AGOTADO'
        WHEN i.stock < 10 THEN 'CRÍTICO'
        ELSE 'BAJO'
    END AS estado
FROM productos p
JOIN inventario i ON p.id_producto = i.id_producto
WHERE i.stock < 20;
SELECT * FROM vista_alerta_stock;

-- 4. Vista: Auditoría de Usuarios y Empleados
-- Cruza las cuentas de acceso al sistema con la información del personal físico.
CREATE OR REPLACE VIEW vista_usuarios_activos AS
SELECT 
    u.username,
    u.rol,
    e.nombre || ' ' || e.apellido AS empleado_real,
    e.cargo
FROM usuarios u
JOIN empleados e ON u.id_empleado = e.id_empleado;
SELECT * FROM vista_usuarios_activos;

-- 5. Vista: Valorización de Inventario por Categoría
-- Calcula el capital total detenido en almacén agrupado por rubro.
CREATE OR REPLACE VIEW vista_valor_inventario_cat AS
SELECT 
    c.nombre AS categoria,
    SUM(i.stock) AS unidades_totales,
    SUM(i.stock * p.precio) AS capital_estimado
FROM productos p
JOIN categorias c ON p.id_categoria = c.id_categoria
JOIN inventario i ON p.id_producto = i.id_producto
GROUP BY c.nombre;
SELECT * FROM vista_valor_inventario_cat;

-- 6. Vista: Rendimiento de Proveedores
-- Analiza la inversión total y la cantidad de órdenes realizadas a cada proveedor.
CREATE OR REPLACE VIEW vista_analisis_proveedores AS
SELECT 
    pr.nombre AS proveedor,
    COUNT(DISTINCT c.id_compra) AS numero_compras,
    SUM(dc.cantidad * dc.costo_unitario) AS inversion_total
FROM proveedores pr
JOIN compras c ON pr.id_proveedor = c.id_proveedor
JOIN detalle_compra dc ON c.id_compra = dc.id_compra
GROUP BY pr.nombre;
SELECT * FROM vista_analisis_proveedores;

-- 7. Vista: Top 10 Productos Rentables
-- Clasifica los productos según el margen de ganancia (Venta vs Promedio Compra).
CREATE OR REPLACE VIEW vista_productos_rentables AS
SELECT 
    p.descripcion_producto,
    p.precio AS precio_venta,
    AVG(dc.costo_unitario) AS costo_promedio,
    (p.precio - AVG(dc.costo_unitario)) AS margen_unitario
FROM productos p
JOIN detalle_compra dc ON p.id_producto = dc.id_producto
GROUP BY p.id_producto, p.descripcion_producto, p.precio
ORDER BY margen_unitario DESC
LIMIT 10;
SELECT * FROM vista_productos_rentables;

-- 8. Vista: Seguimiento de Pagos
-- Permite auditar las ventas y verificar el método de pago utilizado.
CREATE OR REPLACE VIEW vista_conciliacion_pagos AS
SELECT 
    v.id_venta,
    v.fecha,
    mp.tipo AS metodo,
    pg.monto AS monto_pagado
FROM ventas v
JOIN pagos pg ON v.id_venta = pg.id_venta
JOIN metodo_pago mp ON pg.id_metodo = mp.id_metodo;
SELECT * FROM vista_conciliacion_pagos;

-- 9. Vista: Rotación de Productos
-- Calcula la relación entre las unidades vendidas y el stock remanente.
CREATE OR REPLACE VIEW vista_rotacion_productos AS
SELECT 
    p.descripcion_producto,
    SUM(dv.cantidad) AS unidades_vendidas,
    i.stock AS stock_actual,
    ROUND(SUM(dv.cantidad)::numeric / NULLIF(i.stock, 0), 2) AS indice_rotacion
FROM productos p
JOIN inventario i ON p.id_producto = i.id_producto
LEFT JOIN detalle_venta dv ON p.id_producto = dv.id_producto
GROUP BY p.id_producto, p.descripcion_producto, i.stock;
SELECT * FROM vista_rotacion_productos;

-- 10. Vista: Catálogo Digital (Optimizado para Aplicación)
-- Datos limpios y disponibilidad en tiempo real para visualización externa.
CREATE OR REPLACE VIEW vista_catalogo_cliente AS
SELECT 
    p.codigo_producto,
    p.descripcion_producto,
    c.nombre AS categoria,
    p.precio,
    CASE WHEN i.stock > 0 THEN 'Disponible' ELSE 'Agotado' END AS disponibilidad
FROM productos p
JOIN categorias c ON p.id_categoria = c.id_categoria
JOIN inventario i ON p.id_producto = i.id_producto;
SELECT * FROM vista_catalogo_cliente;

-- Productos con su respectivo stock
CREATE OR REPLACE VIEW vista_stock_detallado AS
SELECT 
    p.codigo_producto, 
    p.descripcion_producto, 
    c.nombre AS categoria, 
    i.stock
FROM productos p
JOIN categorias c ON p.id_categoria = c.id_categoria
JOIN inventario i ON p.id_producto = i.id_producto;
SELECT * FROM vista_stock_detallado ORDER BY stock DESC;

