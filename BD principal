-- Ranking de Empleados por Ventas
SELECT 
    e.nombre || ' ' || e.apellido AS empleado,
    SUM(dv.cantidad * dv.precio_unitario) AS total_vendido,
    RANK() OVER (ORDER BY SUM(dv.cantidad * dv.precio_unitario) DESC) AS ranking
FROM empleados e
JOIN ventas v ON e.id_empleado = v.id_empleado
JOIN detalle_venta dv ON v.id_venta = dv.id_venta
GROUP BY e.id_empleado, e.nombre, e.apellido;
-- Crecimiento de Ventas Mes a Mes
WITH ventas_mensuales AS (
    SELECT 
        DATE_TRUNC('month', fecha) AS mes,
        SUM(dv.cantidad * dv.precio_unitario) AS monto_total
    FROM ventas v
    JOIN detalle_venta dv ON v.id_venta = dv.id_venta
    GROUP BY mes
)
SELECT 
    mes, 
    monto_total,
    LAG(monto_total) OVER (ORDER BY mes) AS mes_anterior,
    (monto_total - LAG(monto_total) OVER (ORDER BY mes)) / LAG(monto_total) OVER (ORDER BY mes) * 100 AS porcentaje_crecimiento
FROM ventas_mensuales;
--Análisis de Inventario ABC (Pareto):
SELECT 
    p.descripcion_producto,
    (i.stock * p.precio) AS valor_inventario,
    CUME_DIST() OVER (ORDER BY (i.stock * p.precio) DESC) AS percentil_valor
FROM productos p
JOIN inventario i ON p.id_producto = i.id_producto;
--Clientes "Dormidos" (Subconsultas):
SELECT nombre, apellido 
FROM clientes 
WHERE id_cliente IN (SELECT id_cliente FROM ventas)
AND id_cliente NOT IN (
    SELECT id_cliente FROM ventas WHERE fecha > CURRENT_DATE - INTERVAL '30 days'
);
--Productos más vendidos por Categoría
SELECT categoria, producto, total_unidades
FROM (
    SELECT 
        c.nombre AS categoria,
        p.descripcion_producto AS producto,
        SUM(dv.cantidad) AS total_unidades,
        ROW_NUMBER() OVER (PARTITION BY c.id_categoria ORDER BY SUM(dv.cantidad) DESC) as pos
    FROM productos p
    JOIN categorias c ON p.id_categoria = c.id_categoria
    JOIN detalle_venta dv ON p.id_producto = dv.id_producto
    GROUP BY c.id_categoria, c.nombre, p.id_producto
) t
WHERE pos = 1;
--Correlación entre Método de Pago y Monto Promedio:
SELECT 
    mp.tipo AS metodo,
    COUNT(v.id_venta) AS total_transacciones,
    ROUND(AVG(p.monto), 2) AS monto_promedio
FROM metodo_pago mp
JOIN pagos p ON mp.id_metodo = p.id_metodo
JOIN ventas v ON p.id_venta = v.id_venta
GROUP BY mp.tipo;
--Detección de Stock Crítico (Basado en ventas)
SELECT p.descripcion_producto, i.stock, v_prom.promedio_semanal
FROM productos p
JOIN inventario i ON p.id_producto = i.id_producto
JOIN (
    SELECT id_producto, SUM(cantidad) / 4.0 AS promedio_semanal
    FROM detalle_venta
    GROUP BY id_producto
) v_prom ON p.id_producto = v_prom.id_producto
WHERE i.stock < v_prom.promedio_semanal;
--Pares de Productos (Market Basket Analysis):
SELECT 
    p1.descripcion_producto AS prod_a, 
    p2.descripcion_producto AS prod_b, 
    COUNT(*) AS frecuencia
FROM detalle_venta dv1
JOIN detalle_venta dv2 ON dv1.id_venta = dv2.id_venta AND dv1.id_producto < dv2.id_producto
JOIN productos p1 ON dv1.id_producto = p1.id_producto
JOIN productos p2 ON dv2.id_producto = p2.id_producto
GROUP BY prod_a, prod_b
ORDER BY frecuencia DESC
LIMIT 10;
--Recaudación por Hora/Día (Heatmap Data)
SELECT 
    EXTRACT(DOW FROM fecha) AS dia_semana, -- 0=Domingo
    COUNT(*) AS volumen_ventas,
    SUM(dv.cantidad * dv.precio_unitario) AS recaudacion
FROM ventas v
JOIN detalle_venta dv ON v.id_venta = dv.id_venta
GROUP BY dia_semana
ORDER BY recaudacion DESC;
--Tasa de Retención de Clientes
SELECT 
    COUNT(CASE WHEN compras_cliente > 1 THEN 1 END) * 100.0 / COUNT(*) AS tasa_retencion_porcentaje
FROM (
    SELECT id_cliente, COUNT(*) as compras_cliente
    FROM ventas
    GROUP BY id_cliente
) sub;

